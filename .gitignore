# ======================================================================
# Geheimnisse - nichts davon darf jemals hochgeladen werden
# ======================================================================
# Ein einmal eingecheckter Schluessel ist praktisch nicht mehr aus der
# Historie zu entfernen. Er gilt dann als kompromittiert und muss ersetzt
# werden - beim Lizenzschluessel hiesse das: alle Kundenschluessel neu
# ausstellen und eine neue Fassung veroeffentlichen.
*.pem
*.key
!license_key.pub
license-private*
.co37/
lizenzen.csv

# Der oeffentliche Teil gehoert dagegen INS Repository - er wird
# ausgeliefert, damit CO-37 Schluessel pruefen kann. Die Ausnahme oben
# (!license_key.pub) sorgt dafuer, dass ihn keine der Regeln erwischt.

# Zugangsdaten der Installation
admin.token
secret.key
trusted_proxy
agent.conf

# ======================================================================
# Daten und Zustand
# ======================================================================
*.db
*.db-shm
*.db-wal
data/
*.log
*.log.1

# ======================================================================
# Gebaute Erzeugnisse
# ======================================================================
# Die Pakete entstehen aus dem Quellstand. Sie mitzufuehren blaeht das
# Repository auf und fuehrt zu der Frage, welche Fassung nun gilt.
co37_v*.zip
# Die Signatur und die Pruefsumme gehoeren zum Paket, nicht zum Quellstand.
# Ohne das zugehoerige Archiv sind sie im Repository wertlos, und das
# Archiv steht eine Zeile darueber schon nicht drin.
co37_v*.zip.sig
co37_v*.zip.sha256
# Dasselbe fuer die Signatur des Agent-Codes: sie entsteht beim Bauen
# ueber genau den Stand, den das Paket enthaelt, und gehoert damit zum
# Paket. Im Repository waere sie beim naechsten Commit an agent.py falsch.
agent/agent.py.sig
agent/agent.py.sha256
*.deb
*.msi
packaging/cache/
packaging/_msi_build/
dist/
build/

# ======================================================================
# Python
# ======================================================================
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/

# ======================================================================
# Werkzeuge und Betriebssysteme
# ======================================================================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
OPS_*_Edition_*.pdf

# ======================================================================
# Nicht ins oeffentliche Repository
# ======================================================================
# Geschaeftspost. Die Regel gilt nur im Wurzelverzeichnis - PDFs in
# Unterordnern bleiben versionierbar.
/*.pdf

# Unfertige und nicht freigegebene Arbeiten. Nichts daraus gehoert ins
# oeffentliche Repository - die Videos, Sprachproben und Zwischenstaende
# waren am 2026-09-23 versehentlich mit drin und sind am 2026-11-07 aus
# der Historie entfernt worden.
#
# Die Regel stand bis dahin nur in .git/info/exclude. Die gilt auf genau
# einem Rechner und fehlt in jedem frischen Klon - so ist der Ordner
# damals hereingeraten. Deshalb hier, wo sie mitversioniert wird.
#
# Der Ablageordner selbst liegt inzwischen ausserhalb des Klons - Git
# kann nicht hineingreifen, was wirksamer ist als jede Regel. Die Regel
# hier bleibt als Netz, falls im Arbeitsbaum wieder einer entsteht. Ohne
# Schraegstrich am Anfang gilt sie auf jeder Ebene, nicht nur im
# Wurzelverzeichnis - so weit wie die Ueberspringen-Liste in
# hostnamen-test.py, damit nicht eine Ebene geschuetzt ist und die
# andere nur uebersehen wird.
unfertig/

# Die NUTZLAST, unabhaengig davon wie der Ordner heisst. Am 2026-09-23
# waren es zwei .mp4, zwei .mp3 und ein .tar.gz - gedeckt war davon
# nichts ausser durch den Ordnernamen, und ein Name gilt nur so lange,
# wie er auf jedem Rechner derselbe ist. Eine Endungsregel gilt ueberall
# und braucht niemandes Gedaechtnis. Freigegebene Medien gehoeren in die
# Release-Anhaenge, nicht ins Repository.
*.mp4
*.mov
*.mp3
*.wav
*.tar.gz

# Die Signatur des Agent-Codes, Fall im Wurzelverzeichnis. Die Regel
# weiter oben deckt nur agent/agent.py.sig ab.
/agent.py.sig
